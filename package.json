{
  "name": "akaduy-dev",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "start": "astro dev",
    "lint": "astro check",
    "worker:hackatime:dev": "npx wrangler dev --config wrangler.toml",
    "worker:hackatime:test": "node --test workers/hackatime-status.test.js",
    "worker:hackatime:deploy": "npx wrangler deploy --config wrangler.toml",
    "worker:polls:dev": "npx wrangler dev --config wrangler.blog-polls.toml",
    "worker:polls:deploy": "npx wrangler deploy --config wrangler.blog-polls.toml",
    "worker:umami:dev": "npx wrangler dev --config wrangler.umami.toml",
    "worker:umami:deploy": "npx wrangler deploy --config wrangler.umami.toml",
    "worker:umami:test": "node --test workers/umami-proxy.test.js",
    "worker:deploy": "npm run worker:hackatime:deploy && npm run worker:polls:deploy && npm run worker:umami:deploy",
    "d1:migrate:polls": "npx wrangler d1 migrations apply blog-polls --remote --config wrangler.blog-polls.toml",
    "preview": "astro preview",
    "check": "astro check"
  },
  "dependencies": {
    "@astrojs/react": "^7.0.1",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "astro": "^7.3.8",
    "lucide-react": "^1.54.0",
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4.2.0",
    "tw-animate-css": "1.4.0",
    "typescript": "5.7.3"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  }
}

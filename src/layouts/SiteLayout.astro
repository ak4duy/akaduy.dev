---
import "@fontsource-variable/geist";
import "@fontsource-variable/geist-mono";
import "@/styles/globals.css";

import { ClientRouter } from "astro:transitions";
import { languages, type Language } from "@/lib/i18n";
import { localizedPath } from "@/lib/routes";

interface Props {
  language?: Language;
  title?: string;
  description?: string;
  tags?: string[];
  article?: boolean;
  noindex?: boolean;
  alternatePath?: string;
}

const {
  language = "EN",
  title = "akaduy",
  description = "Self-taught developer. Working with Java, Python, Rust, and whatever breaks next.",
  tags = [],
  article = false,
  noindex = false,
  alternatePath,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const pagePath = Astro.url.pathname.replace(/^\/(en|vn)\/?|\/$/g, "");
const hasTranslation = !noindex && (alternatePath ?? pagePath) === pagePath;
const languageHref = (option: Language) =>
  new URL(localizedPath(option, pagePath), Astro.site).href;
const image = new URL("/favicon-200x200.jpg", Astro.site).href;
---

<!doctype html>
<html
  lang={language === "VN" ? "vi" : "en"}
  class="dark bg-background mdl-js"
  transition:animate={article ? undefined : "none"}
>
  <head>
    <script
      defer
      src="/s.js"
      data-host-url="https://akaduy.dev"
      data-domains="akaduy.dev"
      data-website-id="eac4f9b0-6242-4c87-bd4a-765e35e3db75"
    ></script>
    <ClientRouter fallback="swap" />
    <script>
      import "@/src/scripts/navigation";
    </script>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />

    <link rel="icon" href="/favicon-200x200.jpg" />
    <link rel="apple-touch-icon" href="/favicon-200x200.jpg" />

    {
      noindex
        ? <meta name="robots" content="noindex" />
        : <link rel="canonical" href={canonical} />
    }
    {hasTranslation && languages.map((option) => (
      <link rel="alternate" hreflang={option === "VN" ? "vi" : "en"} href={languageHref(option)} />
    ))}
    {hasTranslation && <link rel="alternate" hreflang="x-default" href={languageHref("EN")} />}
    <link rel="alternate" type="application/rss+xml" title="akaduy blog" href={`/${language.toLowerCase()}/rss.xml`} />

    {tags.length > 0 && <meta name="keywords" content={tags.join(", ")} />}

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:site_name" content={article ? "akaduy blog" : "akaduy"} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={image} />

    {article && tags.map((tag) => <meta property="article:tag" content={tag} />)}

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <slot name="head" />
  </head>

  <body class="font-sans antialiased">
    <slot />
  </body>
</html>

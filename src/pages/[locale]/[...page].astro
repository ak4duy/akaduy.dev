---
import type { GetStaticPaths } from "astro";
import SiteLayout from "@/src/layouts/SiteLayout.astro";
import { BlogIndexPage } from "@/components/blog-index-page";
import { PrivacyPage } from "@/components/privacy-page";
import { PortfolioPage } from "@/components/portfolio-page";
import CurrentWorkStatus from "@/src/components/CurrentWorkStatus.astro";
import { getBlogPosts, toBlogPostSummary } from "@/lib/blog-posts";
import { languages, translations, type Language } from "@/lib/i18n";

export const getStaticPaths = (() =>
  languages.flatMap((language) =>
    [undefined, "experience", "blog", "contact", "privacy"].map((page) => ({
      params: { locale: language.toLowerCase(), page },
      props: { language },
    })),
  )) satisfies GetStaticPaths;

interface Props { language: Language }
const { language } = Astro.props;
const isPrivacy = Astro.params.page === "privacy";
const activeTab = (Astro.params.page ?? "about") as "about" | "experience" | "blog" | "contact";
const privacy = translations[language].privacy;
---

<SiteLayout
  language={language}
  title={isPrivacy ? privacy.metadataTitle : `${translations[language].nav[activeTab]} | akaduy`}
  description={isPrivacy ? privacy.metadataDescription : undefined}
>
  {isPrivacy ? (
    <PrivacyPage initialLanguage={language} />
  ) : activeTab === "blog" ? (
    <BlogIndexPage initialLanguage={language} blogPosts={getBlogPosts(language).map(toBlogPostSummary)} client:load />
  ) : (
    <PortfolioPage activeTab={activeTab} initialLanguage={language} blogPosts={activeTab === "about" ? getBlogPosts(language).slice(0, 3).map(toBlogPostSummary) : []}>
      {activeTab !== "contact" && (
        <CurrentWorkStatus slot="work-status" label={translations[language].home.currentlyWorkingOn} />
      )}
    </PortfolioPage>
  )}
</SiteLayout>

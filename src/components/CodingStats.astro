---
import { translations, type Language } from "@/lib/i18n";

interface Props { language: Language }
const { language } = Astro.props;
const t = translations[language].now;
const rows = [
  { field: "dailyTotal", label: t.today },
  { field: "weeklyTotal", label: t.week },
  { field: "totalTime", label: t.allTime },
  { field: "topLanguage", label: t.topLanguage },
  { field: "lastHeartbeatAt", label: t.lastActive },
];
---

<coding-stats data-locale={language === "VN" ? "vi" : "en"} hidden>
  <dl>
    {rows.map(({ field, label }) => (
      <div data-field={field} hidden>
        <dt>{label}</dt>
        <dd></dd>
      </div>
    ))}
  </dl>
  <p>
    <a href="https://hackatime.hackclub.com" target="_blank" rel="noopener noreferrer">{t.source}</a>
  </p>
</coding-stats>

<style>
  coding-stats { display: block; margin-top: 12px; }
  coding-stats[hidden], [hidden] { display: none; }
  dl > div { display: grid; grid-template-columns: 180px minmax(0, 1fr); gap: 16px; padding: 4px 0; }
  dt { color: var(--muted-foreground); }
  dd { overflow-wrap: anywhere; }
  p { margin-top: 12px; font-size: 12px; color: var(--muted-foreground); }
  @media (max-width: 480px) {
    dl > div { grid-template-columns: 130px minmax(0, 1fr); gap: 10px; }
  }
</style>

<script>
  import { fetchHackatimeStatus } from "@/lib/hackatime";

  type Stats = Partial<Record<"dailyTotal" | "weeklyTotal" | "totalTime" | "topLanguage" | "lastHeartbeatAt", string | null>>;

  // shortcut: the worker mixes "1h 38m" and "23 hrs 9 mins"; normalize here until the worker formats both alike.
  const formatDuration = (text: string) =>
    text.replace(/\s*hrs?\b/g, "h").replace(/\s*mins?\b/g, "m").replace(/\s*secs?\b/g, "s");

  function formatTimeAgo(iso: string, locale: string) {
    const seconds = (new Date(iso).getTime() - Date.now()) / 1000;
    if (!Number.isFinite(seconds)) return null;
    const format = new Intl.RelativeTimeFormat(locale, { numeric: "auto" });
    for (const [unit, size] of [["day", 86_400], ["hour", 3_600], ["minute", 60]] as const) {
      if (Math.abs(seconds) >= size) return format.format(Math.round(seconds / size), unit);
    }
    return format.format(0, "minute");
  }

  function formatField(field: keyof Stats, value: string, locale: string) {
    if (field === "lastHeartbeatAt") return formatTimeAgo(value, locale);
    if (field === "topLanguage") return value.toLowerCase() === "unknown" ? null : value;
    return formatDuration(value);
  }

  class CodingStats extends HTMLElement {
    private interval: number | undefined;

    connectedCallback() {
      void this.load();
      this.interval = window.setInterval(this.load, 60_000);
    }

    disconnectedCallback() {
      window.clearInterval(this.interval);
    }

    private load = async () => {
      if (document.hidden) return;
      try {
        const stats = await fetchHackatimeStatus<Stats>();
        if (!this.isConnected) return;
        let shown = 0;
        for (const row of this.querySelectorAll<HTMLElement>("[data-field]")) {
          const field = row.dataset.field as keyof Stats;
          const raw = stats[field];
          const value = typeof raw === "string" && raw.trim() ? formatField(field, raw.trim(), this.dataset.locale!) : null;
          row.hidden = !value;
          row.querySelector("dd")!.textContent = value ?? "";
          if (value) shown++;
        }
        this.hidden = shown === 0;
      } catch {
        if (this.isConnected) this.hidden = true;
      }
    };
  }

  if (!customElements.get("coding-stats")) {
    customElements.define("coding-stats", CodingStats);
  }
</script>

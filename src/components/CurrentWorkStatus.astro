---
interface Props { label: string }
const { label } = Astro.props;
---

<current-work-status>
  <span hidden>
    <span>{label}</span>{" "}
    <a hidden target="_blank" rel="noopener noreferrer"></a>
    <strong hidden></strong>
    <span data-entity></span>
  </span>
</current-work-status>

<style>
  current-work-status { display: block; }
  current-work-status > span { font-size: 12px; color: var(--muted-foreground); }
  a, strong { font-weight: 600; color: var(--foreground); overflow-wrap: anywhere; }
  a:hover { color: var(--primary); text-decoration: underline; text-underline-offset: 4px; }
  [data-entity] { overflow-wrap: anywhere; }
</style>

<script>
  import { fetchHackatimeStatus } from "@/lib/hackatime";

  type WorkStatus = { project?: string; repoUrl?: string; entity?: string };

  class CurrentWorkStatus extends HTMLElement {
    private loading = false;
    private interval: number | undefined;
    private lastRequestedAt = -Infinity;

    connectedCallback() {
      void this.load();
      this.interval = window.setInterval(this.load, 60_000);
      document.addEventListener("visibilitychange", this.load);
    }

    disconnectedCallback() {
      window.clearInterval(this.interval);
      document.removeEventListener("visibilitychange", this.load);
    }

    private load = async () => {
      if (document.hidden || this.loading) return;
      const now = performance.now();
      if (now - this.lastRequestedAt < 60_000) return;
      this.lastRequestedAt = now;
      this.loading = true;
      try {
        const status = await fetchHackatimeStatus<WorkStatus>();
        if (!this.isConnected) return;
        const row = this.querySelector("span")!;
        row.hidden = !status.project;
        if (!status.project) return;

        const link = this.querySelector("a")!;
        const name = this.querySelector("strong")!;
        const fallback = /^[A-Za-z0-9._-]+$/.test(status.project)
          ? `https://github.com/ak4duy/${status.project}` : null;
        const url = status.repoUrl || fallback;
        // API-provided links must be web URLs.
        const safeUrl = url && /^https?:\/\//i.test(url) ? url : null;
        link.hidden = !safeUrl;
        name.hidden = Boolean(safeUrl);
        link.textContent = name.textContent = status.project;
        if (safeUrl) link.href = safeUrl;
        this.querySelector("[data-entity]")!.textContent = status.entity ? ` (${status.entity})` : "";
      } catch {
        if (this.isConnected) this.querySelector("span")!.hidden = true;
      } finally {
        this.loading = false;
      }
    };
  }

  if (!customElements.get("current-work-status")) {
    customElements.define("current-work-status", CurrentWorkStatus);
  }
</script>
